# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Until these are set, the app runs on the localStorage prototype store and
# the Supabase client (src/lib/supabase.ts) stays inert.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---------------------------------------------------------------------------
# DEV-ONLY seeded auto-login (src/lib/dev-auth.ts).
# When these are set AND the build is a dev build (import.meta.env.DEV), the dev
# server boots already signed in as a REAL seeded Supabase test user (real JWT,
# RLS, Edge Functions all work). A tiny bottom-left switcher flips between roles.
# These NEVER ship in a production build — the dev-auth module is dynamic-imported
# behind a dead `if (import.meta.env.DEV)` and dropped by the bundler. Leave blank
# to keep the dev server unauthenticated. Passwords live only in your local
# .env.local (gitignored); fill from the seeded test users.
VITE_DEV_AUTH_ATHLETE_EMAIL=
VITE_DEV_AUTH_ATHLETE_PASSWORD=
VITE_DEV_AUTH_MANAGER_EMAIL=
VITE_DEV_AUTH_MANAGER_PASSWORD=
VITE_DEV_AUTH_ADMIN_EMAIL=
VITE_DEV_AUTH_ADMIN_PASSWORD=
