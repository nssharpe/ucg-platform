{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/dev/ucg-platform/scripts/destructive-command-guard.mjs",
            "statusMessage": "Destructive-command guard…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/dev/ucg-platform/scripts/hooks/post-bash-checks.mjs",
            "statusMessage": "Post-Bash checks (docs, verify_jwt, dev-auth firewall)…",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
